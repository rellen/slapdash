<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Slapdash" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const root = document.documentElement;
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        // Mark the toggle button for the current choice as pressed.
        const syncToggle = () => {
          const choice = root.getAttribute("data-theme-source") === "system" ? "system" : root.getAttribute("data-theme");
          document.querySelectorAll("[data-phx-theme]").forEach((button) => {
            button.setAttribute("aria-pressed", String(button.dataset.phxTheme === choice));
          });
        };

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            root.setAttribute("data-theme", systemTheme());
            root.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            root.setAttribute("data-theme", theme);
            root.setAttribute("data-theme-source", "user");
          }
          syncToggle();
        };
        if (!root.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        document.addEventListener("DOMContentLoaded", syncToggle);
        window.addEventListener("phx:page-loading-stop", syncToggle);
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (root.getAttribute("data-theme-source") === "system") {
            root.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
