#!/bin/sh
# Sourced by the release scripts before they start the VM. See
# `mix help release` for the variables that can be set here.

# Builds that drop the generated COOKIE file from the release (the Nix
# package does, so the cookie does not end up world-readable in the store)
# still need a cookie. Unless RELEASE_COOKIE is set:
#
# - with RELEASE_COOKIE_FILE, read the cookie from that file, creating it
#   with a random cookie (readable by its owner only) if it is missing or
#   empty. The server and `rpc`/`remote` then share it.
# - otherwise, use a random cookie for this boot. `rpc` and `remote` cannot
#   reach a node started this way.
if [ -z "${RELEASE_COOKIE:-}" ] && [ ! -f "$RELEASE_ROOT/releases/COOKIE" ]; then
  if [ -n "${RELEASE_COOKIE_FILE:-}" ]; then
    if [ ! -s "$RELEASE_COOKIE_FILE" ]; then
      (umask 077 && od -An -N24 -tx1 /dev/urandom | tr -d ' \n' > "$RELEASE_COOKIE_FILE")
    fi
    RELEASE_COOKIE="$(cat "$RELEASE_COOKIE_FILE")"
  else
    RELEASE_COOKIE="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
  fi
  export RELEASE_COOKIE
fi
